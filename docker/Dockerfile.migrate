# One-shot Drizzle migration runner (docker compose `migrate` service).
FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY drizzle.config.ts ./
COPY drizzle ./drizzle
COPY db ./db
COPY lib/seed ./lib/seed
COPY scripts/verify-schema.ts ./scripts/verify-schema.ts
COPY scripts/seed-superadmin.ts ./scripts/seed-superadmin.ts
COPY tsconfig.json ./
CMD ["sh", "-c", "npm run db:migrate && npm run db:seed && npm run db:schema:check"]
