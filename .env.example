# Postgres connection string (Drizzle + Better Auth)
DATABASE_URL=postgresql://squishmallow:change-me@localhost:5432/squishmallow

# Secret for signing Better Auth session cookies (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me-use-openssl-rand-base64-32

# Public base URL of the app (used by Better Auth for redirects and callbacks)
BETTER_AUTH_URL=http://localhost

# SMTP server hostname for transactional email (invites, password reset)
SMTP_HOST=mail.bmail.im

# SMTP port (465 uses implicit TLS)
SMTP_PORT=465

# Enable implicit TLS — required for port 465
SMTP_SECURE=true

# SMTP auth username (from address)
SMTP_USER=noreply@squishatlas.com

# SMTP auth password (required — obtain from your mail provider)
SMTP_PASSWORD=

# Directory where squish photo derivatives are stored (use /data/uploads in Docker)
UPLOADS_DIR=./data/uploads

# GitHub repo for landing page stars link (owner/name)
NEXT_PUBLIC_GITHUB_REPO=bengivre/squishatlas

# Email of the superadmin account seeded on first boot
SUPERADMIN_EMAIL=admin@example.com

# Initial password for the superadmin account (must be changed on first login)
SUPERADMIN_INITIAL_PASSWORD=change-me

# --- Docker Compose only (not required by the Next.js app) ---
# POSTGRES_PASSWORD=change-me
# CADDY_DOMAIN=squishatlas.com
# CADDY_TLS_CERT=
# CADDY_TLS_KEY=
# BACKUP_RETENTION=14
# BACKUP_CRON=0 2 * * *
